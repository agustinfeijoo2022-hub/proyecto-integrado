# Copia este archivo a .env junto a package.json.
# Reinicia Node y Vite al cambiar la configuración. No subas .env a Git.
PORT=3001
FRONTEND_ORIGIN=http://localhost:8443
VITE_API_URL=http://localhost:3001/api

# PostgreSQL local: base de datos creada previamente por el usuario.
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/fyag_db

# MongoDB: debe estar iniciado para utilizar inventario y compras.
MONGODB_URI=mongodb://127.0.0.1:27017/fyag_logs

# false para desarrollo HTTP local; true para HTTPS.
COOKIE_SECURE=false

# Define contraseñas propias de entre 12 y 256 caracteres.
# Una cuenta con contraseña vacía queda deshabilitada.
# Configura al menos una cuenta para iniciar el servidor.
FYAG_GERENCIA_PASSWORD=gerencia12345
FYAG_FINANZAS_PASSWORD=finanzas12345
FYAG_SUPERVISOR_PASSWORD=supervisor12345
FYAG_TECNICO_PASSWORD=tecnico12345
